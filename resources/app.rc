#include <windows.h>
#include <commctrl.h>

1 24 "resources/app.manifest"

1 VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Styled Dock - macOS-inspired dock for Windows\0"
            VALUE "FileVersion", "1.3.0\0"
            VALUE "InternalName", "styled-dock\0"
            VALUE "OriginalFilename", "styled-dock.exe\0"
            VALUE "ProductName", "Styled Dock\0"
            VALUE "ProductVersion", "1.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

101 DIALOGEX 0, 0, 449, 290
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Styled Dock Settings"
FONT 9, "Segoe UI Variable Text"
BEGIN
    LTEXT "Styled Dock", 136, 13, 16, 91, 16
    CONTROL "", 133, "ListBox", LBS_NOTIFY | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | WS_TABSTOP, 8, 42, 99, 174
    LTEXT "", 134, 129, 16, 300, 24, SS_NOPREFIX
    LTEXT "", 135, 130, 42, 298, 15, SS_NOPREFIX

    LTEXT "&Language", 231, 130, 73, 95, 11
    COMBOBOX 149, 249, 70, 179, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Start automatically when I sign in to Windows", 150, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 112, 298, 16
    LTEXT "Language changes apply after saving and restarting the dock.", 232, 130, 146, 298, 30

    LTEXT "&Display", 200, 130, 71, 95, 11
    COMBOBOX 110, 249, 68, 179, 96, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Dock mode", 201, 130, 98, 95, 11
    COMBOBOX 111, 249, 95, 179, 88, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL "Show &top bar", 112, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 132, 298, 14
    CONTROL "Show app tray icons (experimental)", 144, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 210, 298, 14
    CONTROL "Hide dock and top bar in &fullscreen", 113, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 158, 298, 14
    CONTROL "Hide the &Windows taskbar while the dock is running", 114, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 184, 298, 14

    LTEXT "Color mode", 222, 130, 69, 95, 11
    COMBOBOX 139, 249, 66, 179, 72, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Dock si&ze", 210, 130, 98, 116, 11
    CONTROL "Dock size", 115, TRACKBAR_CLASS, TBS_NOTICKS | WS_TABSTOP, 246, 97, 147, 21
    LTEXT "", 211, 398, 98, 33, 11
    LTEXT "&Hover zoom", 212, 130, 122, 116, 11
    CONTROL "Hover zoom", 116, TRACKBAR_CLASS, TBS_NOTICKS | WS_TABSTOP, 246, 121, 147, 21
    LTEXT "", 213, 398, 122, 33, 11
    LTEXT "Dock background opacity", 218, 130, 146, 116, 11
    CONTROL "", 131, TRACKBAR_CLASS, TBS_NOTICKS | WS_TABSTOP, 246, 145, 147, 21
    LTEXT "", 137, 398, 146, 33, 11
    LTEXT "Top bar background opacity", 219, 130, 170, 116, 11
    CONTROL "", 132, TRACKBAR_CLASS, TBS_NOTICKS | WS_TABSTOP, 246, 169, 147, 21
    LTEXT "", 138, 398, 170, 33, 11
    CONTROL "Bounce on launch", 119, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 198, 148, 12

    LTEXT "Icon size (px)", 223, 130, 69, 116, 10
    EDITTEXT 140, 249, 66, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "24-96", 224, 300, 69, 124, 10
    LTEXT "Icon spacing (px)", 225, 130, 94, 116, 10
    EDITTEXT 141, 249, 91, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "0-32", 226, 300, 94, 124, 10
    LTEXT "Edge padding (px)", 227, 130, 119, 116, 10
    EDITTEXT 142, 249, 116, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "4-40", 228, 300, 119, 124, 10
    LTEXT "App label delay (ms)", 229, 130, 144, 116, 10
    EDITTEXT 143, 249, 141, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "0-3000 (1000 = 1 second)", 230, 300, 144, 124, 10
    LTEXT "Animation speed (%)", 214, 130, 169, 116, 10
    EDITTEXT 117, 249, 166, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "0 (instant) or 25-200", 215, 300, 169, 124, 10
    LTEXT "Auto-hide delay (ms)", 216, 130, 194, 116, 10
    EDITTEXT 118, 249, 191, 40, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "100-3000", 217, 300, 194, 124, 10

    CONTROL "Show &Start menu", 145, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 71, 298, 14
    CONTROL "Show Windows &Search", 146, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 101, 298, 14
    CONTROL "Show &Downloads", 147, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 130, 131, 298, 14

    LISTBOX 120, 130, 65, 195, 74, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Move &up", 121, 333, 65, 95, 17
    PUSHBUTTON "Move &down", 122, 333, 87, 95, 17
    PUSHBUTTON "&Remove", 123, 333, 109, 95, 17
    LTEXT "&Name", 220, 130, 151, 50, 11
    EDITTEXT 124, 185, 147, 243, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Pa&th / App ID", 221, 130, 177, 52, 11
    EDITTEXT 125, 185, 173, 179, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&Browse...", 126, 369, 173, 59, 16
    PUSHBUTTON "Installed a&pps...", 148, 130, 199, 95, 17
    PUSHBUTTON "&Add", 127, 289, 199, 57, 17
    PUSHBUTTON "Update &selected", 128, 351, 199, 77, 17

    CONTROL "", 129, "SysLink", WS_TABSTOP, 130, 230, 298, 12
    LTEXT "", 153, 130, 246, 298, 12, SS_NOPREFIX
    PUSHBUTTON "Save a cop&y...", 152, 13, 264, 94, 17
    PUSHBUTTON "Restore de&faults", 130, 130, 264, 84, 17
    DEFPUSHBUTTON "&Save and restart", IDOK, 260, 264, 98, 17
    PUSHBUTTON "Cancel", IDCANCEL, 364, 264, 64, 17
END

102 DIALOGEX 0, 0, 320, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose an installed app"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Search installed apps", -1, 12, 12, 290, 12
    EDITTEXT 1001, 12, 28, 296, 16, ES_AUTOHSCROLL | WS_TABSTOP
    LISTBOX 1002, 12, 52, 296, 188, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Choose", IDOK, 182, 252, 60, 17
    PUSHBUTTON "Cancel", IDCANCEL, 248, 252, 60, 17
END
